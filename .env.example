# Copie este arquivo para `.env` na raiz do projeto e preencha com valores reais.

# Porta do servidor da API
PORT=8080

# Segredo usado para assinar os tokens JWT (gere um valor forte e aleatório)
JWT_SECRET=cole_aqui_um_segredo_forte

# String de conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/irrigacao_db
