# Variáveis de Ambiente - Backend (PIBEX 2026)

# Porta do Servidor
PORT=8080

# URL de Conexão com PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irrigacao_db

# Segredo para assinatura de Tokens JWT
JWT_SECRET=coloque_uma_chave_secreta_longa_e_segura_aqui

# Ambiente de Execução (development | production)
NODE_ENV=development
