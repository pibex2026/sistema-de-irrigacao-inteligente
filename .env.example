# Variáveis de Ambiente - Backend & Docker (PIBEX 2026)

# Porta do Servidor
PORT=8080

# Credenciais PostgreSQL (usadas pelo docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha_postgres
POSTGRES_DB=irrigacao_db

# URL de Conexão com PostgreSQL (uso local fora do Docker)
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:troque_esta_senha_postgres@localhost:5432/irrigacao_db

# Segredo para assinatura de Tokens JWT (obrigatório em produção)
JWT_SECRET=coloque_uma_chave_secreta_longa_e_segura_aqui

# Chave de autenticação para o dispositivo ESP32 enviar telemetria
DEVICE_API_KEY=coloque_uma_chave_secreta_para_o_esp32_aqui

# Ambiente de Execução (development | production)
NODE_ENV=development
